    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <Link>
      <!-- Windows subsystem: no console window; the entry point is wWinMain. -->
      <SubSystem>Windows</SubSystem>
      <!-- comctl32: common controls (LoadIconMetric, tree view...); shcore: per-monitor DPI;
           windowscodecs: WIC, to read PNG icons; uxtheme: control visual styles;
           dwmapi: dark title bar; xmllite + shlwapi: reading XML files;
           winhttp: update check; version: reading the version resource.
           All are part of Windows. -->
      <AdditionalDependencies>comctl32.lib;shcore.lib;windowscodecs.lib;uxtheme.lib;dwmapi.lib;xmllite.lib;shlwapi.lib;winhttp.lib;version.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <!-- Merged into the manifest the linker generates (which already adds asInvoker). -->
      <AdditionalManifestFiles>Popa.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
